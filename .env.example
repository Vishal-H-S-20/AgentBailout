AGENTBAILOUT_DATABASE_URL=sqlite:///./agentbailout.db
AGENTBAILOUT_STAGE_SECONDS=0.5
AGENTBAILOUT_BACKEND_URL=http://127.0.0.1:8003
# Optional, backend environment only. Never place a key in an agent configuration.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# GOOGLE_API_KEY is also supported for Gemini; takes precedence over GEMINI_API_KEY.
